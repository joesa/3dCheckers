[Unit]
Description=Coturn TURN Server for Aether Draughts
Documentation=https://github.com/coturn/coturn
After=network-online.target
Wants=network-online.target
# never stop retrying: TURN must come back on its own
StartLimitIntervalSec=0

[Service]
Type=simple
# /etc, not the repo: /run/media/joe/Data1 is not mounted at boot
ExecStart=/usr/bin/turnserver -c /etc/turnserver.conf --pidfile=
Restart=always
RestartSec=5
NoNewPrivileges=true
LimitNOFILE=65535

# Security hardening
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectClock=true
ProtectProc=noaccess
ProcSubset=pid

[Install]
WantedBy=multi-user.target
